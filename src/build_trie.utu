using Buffer from std:Buffer
using console from std:Console

// Builds the packed level-order English dictionary trie from /usr/share/dict/words.
// Run with: utu src/build_trie.utu

let read_text_file: fun(Str) Str = @es/\
    (path) => {
        const fs = require("node:fs");
        return fs.readFileSync(path, "utf8");
    }
\/

let write_bytes_begin: fun(I32) Void = @es/\
    (size) => {
        globalThis.__outBuf = new Uint8Array(size);
        globalThis.__outPos = 0;
    }
\/

let write_u8: fun(I32) Void = @es/\
    (b) => {
        globalThis.__outBuf[globalThis.__outPos++] = b & 0xff;
    }
\/

let write_u32_le: fun(I32) Void = @es/\
    (v) => {
        const buf = globalThis.__outBuf;
        let p = globalThis.__outPos;
        buf[p] = v & 0xff;
        buf[p + 1] = (v >>> 8) & 0xff;
        buf[p + 2] = (v >>> 16) & 0xff;
        buf[p + 3] = (v >>> 24) & 0xff;
        globalThis.__outPos = p + 4;
    }
\/

let write_bytes_save: fun(Str) I32 = @es/\
    (path) => {
        const fs = require("node:fs");
        const slice = globalThis.__outBuf.subarray(0, globalThis.__outPos);
        fs.writeFileSync(path, slice);
        return slice.length;
    }
\/

struct BuildNode:
    | children_mask: I32
    | terminators_mask: I32
    | children: ?Array[?BuildNode]

fn new_node() BuildNode {
    return BuildNode {
        children_mask: 0,
        terminators_mask: 0,
        children: null,
    }
}

// Super letter pairs (tokens 26..31): th, he, in, er, an, re
fn match_super_pair(c0: I32, c1: I32) I32 {
    if c0 == 116 and c1 == 104 {
        return 26
    } // th
    if c0 == 104 and c1 == 101 {
        return 27
    } // he
    if c0 == 105 and c1 == 110 {
        return 28
    } // in
    if c0 == 101 and c1 == 114 {
        return 29
    } // er
    if c0 == 97 and c1 == 110 {
        return 30
    } // an
    if c0 == 114 and c1 == 101 {
        return 31
    } // re
    return -1
}

// Terminator-only suffix tokens (26..31): ess, ion, ous, ly, ic, al
fn match_suffix3(c0: I32, c1: I32, c2: I32) I32 {
    if c0 == 101 and c1 == 115 and c2 == 115 {
        return 26
    } // ess
    if c0 == 105 and c1 == 111 and c2 == 110 {
        return 27
    } // ion
    if c0 == 111 and c1 == 117 and c2 == 115 {
        return 28
    } // ous
    return -1
}

fn match_suffix2(c0: I32, c1: I32) I32 {
    if c0 == 108 and c1 == 121 {
        return 29
    } // ly
    if c0 == 105 and c1 == 99 {
        return 30
    } // ic
    if c0 == 97 and c1 == 108 {
        return 31
    } // al
    return -1
}

fn mask_byte_len(mask: I32) I32 {
    if mask == 0 {
        return 1
    }
    if (mask & -16777216) != 0 {
        return 4
    } // 0xFF000000
    if (mask & 16711680) != 0 {
        return 3
    } // 0x00FF0000
    if (mask & 65280) != 0 {
        return 2
    } // 0x0000FF00
    return 1
}

fn add_word(root: BuildNode, word: Str) Void {
    let n = word.len()
    if n == 0 {
        return
    }

    // Determine terminator token (longest suffix match)
    let term_token = -1
    let prefix_len = n - 1

    if n >= 3 {
        let s3 = match_suffix3(word[n - 3], word[n - 2], word[n - 1])
        if s3 >= 0 {
            term_token = s3
            prefix_len = n - 3
        }
    }
    if term_token < 0 and n >= 2 {
        let s2 = match_suffix2(word[n - 2], word[n - 1])
        if s2 >= 0 {
            term_token = s2
            prefix_len = n - 2
        }
    }
    if term_token < 0 {
        term_token = word[n - 1] - 97
    }

    // Tokenize prefix and walk/insert into trie
    let cur = root
    let i = 0
    while (i < prefix_len) {
        let tok = -1
        if i + 1 < prefix_len {
            tok = match_super_pair(word[i], word[i + 1])
            if tok >= 0 {
                i += 2
            }
        }
        if tok < 0 {
            let c = word[i]
            i += 1
            if c >= 97 and c <= 122 {
                tok = c - 97
            } else {
                continue
            }
        }

        let children = promote cur.children {
            |arr| => arr,
            ~> {
                let fresh: Array[?BuildNode] = Array[?BuildNode].new(32, null)
                cur.children = fresh
                fresh
            },
        }

        let bit = 1 << tok
        let next = promote children[tok] {
            |child| => child,
            ~> {
                let child = new_node()
                children[tok] = child
                cur.children_mask = cur.children_mask | bit
                child
            },
        }
        cur = next
    }

    cur.terminators_mask = cur.terminators_mask | (1 << term_token)
}

fn is_lower_alpha(s: Str) Bool {
    let n = s.len()
    if n == 0 {
        return false
    }
    let i = 0
    while (i < n) {
        let c = s[i]
        if c < 97 or c > 122 {
            return false
        }
        i += 1
    }
    return true
}

main {
    let words_file = "/usr/share/dict/words"
    let output_file = "docs/trie_data.bin"

    console.log("Reading words from " + words_file + "...")
    let text = read_text_file(words_file)
    let len = text.len()

    let root = new_node()
    let word_count = 0
    let start = 0
    let pos = 0

    while (pos <= len) {
        let at_end = pos == len
        let is_nl = if at_end {
            true
        } else {
            text[pos] == 10 or text[pos] == 13
        }
        if is_nl {
            if pos > start {
                let raw = text.slice(start, pos).to_lower()
                if is_lower_alpha(raw) {
                    add_word(root, raw)
                    word_count += 1
                }
            }
            start = pos + 1
        }
        pos += 1
    }

    console.log("Inserted " + word_count.str() + " words. Running level-order BFS...")

    let level_basis: Array[I32] = Array[I32].new(50, 0)
    let all_nodes = Buffer[BuildNode].new()
    let current = Buffer[BuildNode].new()
    current.push(root)

    for (0 ..< 50) |level| {
        level_basis[level] = all_nodes.len()
        let next = Buffer[BuildNode].new()
        let count = current.len()
        let idx = 0
        while (idx < count) {
            let node = current[idx]
            all_nodes.push(node)
            promote node.children {
                |children| => {
                    let mask = node.children_mask
                    while (mask != 0) {
                        let bit = I32.ctz(mask)
                        mask = mask & (mask - 1)
                        promote children[bit] {
                            |child| => next.push(child),
                            ~> {},
                        }
                    }
                },
                ~> {},
            }
            idx += 1
        }
        current = next
    }

    let node_count = all_nodes.len()
    let checkpoint_count = (node_count / 32) + 1
    console.log("Trie built: " + node_count.str() + " nodes, " + checkpoint_count.str() + " checkpoints")

    // Exact upper bound: 208 header + 9 bytes/node max + 4 bytes/checkpoint
    let max_bytes = 208 + node_count * 9 + checkpoint_count * 4
    write_bytes_begin(max_bytes)

    // Header
    write_u32_le(node_count)
    write_u32_le(checkpoint_count)
    for (0 ..< 50) |i| {
        write_u32_le(level_basis[i])
    }

    // Packed nodes
    let i = 0
    while (i < node_count) {
        let node = all_nodes[i]
        let c_mask = node.children_mask
        let t_mask = node.terminators_mask
        let c_len = mask_byte_len(c_mask)
        let t_len = mask_byte_len(t_mask)
        let length_byte = ((t_len - 1) << 2) | (c_len - 1)
        write_u8(length_byte)

        let b = 0
        while (b < c_len) {
            write_u8((c_mask >>> (b * 8)) & 255)
            b += 1
        }
        b = 0
        while (b < t_len) {
            write_u8((t_mask >>> (b * 8)) & 255)
            b += 1
        }
        i += 1
    }

    // Checkpoints
    let running = 0
    i = 0
    while (i < node_count) {
        if (i & 31) == 0 {
            write_u32_le(running)
        }
        running += I32.popcnt(all_nodes[i].children_mask)
        i += 1
    }

    let written = write_bytes_save(output_file)
    console.log("Wrote " + written.str() + " bytes to " + output_file)
}
