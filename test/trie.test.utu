using trie from "../src/trie.utu"

test "contains common words and rejects non-words" {
    let t = trie.load()
    assert t.node_count > 400000
    assert trie.contains(t, "hello")
    assert trie.contains(t, "world")
    assert trie.contains(t, "the")
    assert trie.contains(t, "computer")
    assert trie.contains(t, "HELLO")
    assert not trie.contains(t, "xyzzynotaword")
    assert not trie.contains(t, "")
}

test "autocomplete returns valid words" {
    let t = trie.load()
    let r = trie.autocomplete(t, "hel", 10)
    assert r.len() > 0
    for (r) |w| {
        assert w.len() > 0
        assert trie.contains(t, w)
    }
}

test "handsome autocomplete has no invalid variants" {
    let t = trie.load()
    let res = trie.autocomplete(t, "handsome", 50)
    for (res) |w| {
        assert w.len() > 0
        assert trie.contains(t, w)
        assert w != "handsomeiy"
        assert w != "handsomeiess"
        assert w != "handsomeiness"
    }
}

test "backtrack on bigrams" {
    let t = trie.load()
    let res = trie.autocomplete(t, "wort", 50)
    assert res.len() > 0
    for (res) |w| {
        assert trie.contains(t, w)
        assert w.starts_with("wort")
    }
}

test "all autocomplete results for common prefixes are valid words" {
    let t = trie.load()
    let prefixes = [
        "a", "b", "c", "d", "e", "f", "g", "h", "i", "j",
        "k", "l", "m", "n", "o", "p", "q", "r", "s", "t",
        "u", "v", "w", "x", "y", "z", "th", "he", "in", "er",
        "an", "re", "hand", "hands", "handsome", "hel", "the", "cat", "run", "walk",
        "beau", "quick", "ther", "there", "wh", "qu", "str", "pre",
    ]
    for (prefixes) |p| {
        let res = trie.autocomplete(t, p, 200)
        for (res) |w| {
            assert w.len() > 0
            assert trie.contains(t, w)
        }
    }
}

test "from_bytes rejects truncated data" {
    let tiny: Array[I32] = Array[I32].new(10, 0)
    let bad = trie.from_bytes(tiny)
    let is_null = promote bad {
        |t| => false,
        ~> true,
    }
    assert is_null
}
